@using System.Security.Claims
@{
    string title = ViewData["Title"]?.ToString() ?? "Orizon Agents";
    string currentSection = ViewData["Section"]?.ToString() ?? "Administração";
    string fullName = User.FindFirstValue(OrizonClaimTypes.FullName) ?? User.Identity?.Name ?? "Usuário";
    string initial = string.IsNullOrWhiteSpace(fullName) ? "U" : fullName[..1].ToUpperInvariant();
    bool isPlatformAdmin = User.IsInRole(OrizonRoles.PlatformAdmin);
    bool isTenantAdmin = User.IsInRole(OrizonRoles.TenantAdmin);

    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string Active(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title - Orizon Agents</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>

<body class="admin-shell">

<div class="admin-layout" id="adminLayout">

    <button type="button"
            class="admin-sidebar-backdrop"
            id="sidebarBackdrop"
            aria-label="Fechar menu"
            aria-hidden="true"
            tabindex="-1"></button>

    <aside class="admin-sidebar" id="adminSidebar">

        <div class="admin-sidebar__top">

            <a class="admin-brand"
               asp-controller="Home"
               asp-action="Welcome">

                <span class="admin-brand__mark">O</span>

                <span class="admin-brand__text">
                    <strong>Orizon Agents</strong>
                    <small>Orizon Platform</small>
                </span>

            </a>

            <button type="button"
                    class="admin-sidebar__toggle"
                    id="sidebarToggle"
                    aria-label="Recolher menu"
                    title="Recolher menu">
                ‹
            </button>

        </div>

        <nav class="admin-nav">

            @if (isPlatformAdmin)
            {
                <div class="admin-nav__group">
                    <span class="admin-nav__label">PLATAFORMA</span>

                    <a class="@Active("PlatformDashboard")"
                       asp-controller="PlatformDashboard"
                       asp-action="Index"
                       title="Visão da plataforma">
                        <span class="admin-icon">@await Html.PartialAsync("_IconDashboard")</span>
                        <span class="admin-nav__text">Visão da plataforma</span>
                    </a>

                    <a class="@Active("PlatformTenants")"
                       asp-controller="PlatformTenants"
                       asp-action="Index"
                       title="Organizações">
                        <span class="admin-icon">@await Html.PartialAsync("_IconOrganization")</span>
                        <span class="admin-nav__text">Organizações</span>
                    </a>

                    <a class="@Active("PlatformPlans")"
                       asp-controller="PlatformPlans"
                       asp-action="Index"
                       title="Planos">
                        <span class="admin-icon">@await Html.PartialAsync("_IconPlan")</span>
                        <span class="admin-nav__text">Planos</span>
                    </a>

                    <a class="@Active("PlatformSubscriptions")"
                       asp-controller="PlatformSubscriptions"
                       asp-action="Index"
                       title="Assinaturas">
                        <span class="admin-icon">@await Html.PartialAsync("_IconSubscription")</span>
                        <span class="admin-nav__text">Assinaturas</span>
                    </a>

                    <a class="@Active("PlatformWhatsApp")"
                       asp-controller="PlatformWhatsApp"
                       asp-action="Index"
                       title="WhatsApp">
                        <span class="admin-icon">@await Html.PartialAsync("_IconWhatsApp")</span>
                        <span class="admin-nav__text">WhatsApp</span>
                    </a>
                </div>
            }

            @if (isTenantAdmin)
            {
                <div class="admin-nav__group">
                    <span class="admin-nav__label">WORKSPACE</span>

                    <a class="@Active("AdminDashboard")"
                       asp-controller="AdminDashboard"
                       asp-action="Index"
                       title="Visão geral">
                        <span class="admin-icon">@await Html.PartialAsync("_IconDashboard")</span>
                        <span class="admin-nav__text">Visão geral</span>
                    </a>

                    <a class="@Active("Agents")"
                       asp-controller="Agents"
                       asp-action="Index"
                       title="Agentes de IA">
                        <span class="admin-icon">@await Html.PartialAsync("_IconAgent")</span>
                        <span class="admin-nav__text">Agentes de IA</span>
                    </a>

                    <a class="@Active("Knowledge")"
                       asp-controller="Knowledge"
                       asp-action="Index"
                       title="Conhecimento">
                        <span class="admin-icon">@await Html.PartialAsync("_IconKnowledge")</span>
                        <span class="admin-nav__text">Conhecimento</span>
                    </a>

                    <a class="@Active("AiCredentials")"
                       asp-controller="AiCredentials"
                       asp-action="Index"
                       title="Credenciais de IA">
                        <span class="admin-icon">@await Html.PartialAsync("_IconCredential")</span>
                        <span class="admin-nav__text">Credenciais de IA</span>
                    </a>

                    <a class="@Active("Tools")"
                       asp-controller="Tools"
                       asp-action="Index"
                       title="Ferramentas">
                        <span class="admin-icon">@await Html.PartialAsync("_IconTools")</span>
                        <span class="admin-nav__text">Ferramentas</span>
                    </a>

                    <a class="@Active("ToolApprovals")"
                       asp-controller="ToolApprovals"
                       asp-action="Index"
                       title="Aprovações">
                        <span class="admin-icon">@await Html.PartialAsync("_IconTools")</span>
                        <span class="admin-nav__text">Aprovações</span>
                    </a>

                    <a class="@Active("Integrations")"
                       asp-controller="Integrations"
                       asp-action="Index"
                       title="Integrações">
                        <span class="admin-icon">@await Html.PartialAsync("_IconIntegrations")</span>
                        <span class="admin-nav__text">Integrações</span>
                    </a>
                    <a class="@Active("WhatsApp")"
                       asp-controller="WhatsApp"
                       asp-action="Index"
                       title="WhatsApp">
                        <span class="admin-icon">@await Html.PartialAsync("_IconWhatsApp")</span>
                        <span class="admin-nav__text">WhatsApp</span>
                    </a>
                </div>

                <div class="admin-nav__group">
                    <span class="admin-nav__label">GESTÃO</span>

                    <a class="@Active("TenantUsers")"
                       asp-controller="TenantUsers"
                       asp-action="Index"
                       title="Usuários">
                        <span class="admin-icon">@await Html.PartialAsync("_IconUsers")</span>
                        <span class="admin-nav__text">Usuários</span>
                    </a>

                    <a class="@Active("Organization")"
                       asp-controller="Organization"
                       asp-action="Index"
                       title="Organização">
                        <span class="admin-icon">@await Html.PartialAsync("_IconOrganization")</span>
                        <span class="admin-nav__text">Organização</span>
                    </a>

                    <a class="@Active("Billing")"
                       asp-controller="Billing"
                       asp-action="Index"
                       title="Meu plano">
                        <span class="admin-icon">@await Html.PartialAsync("_IconPlan")</span>
                        <span class="admin-nav__text">Meu plano</span>
                    </a>
                </div>
            }
            else if (!isPlatformAdmin)
            {
                <div class="admin-nav__group">
                    <span class="admin-nav__label">GESTÃO</span>

                    <a class="@Active("Billing")"
                       asp-controller="Billing"
                       asp-action="Index">
                        <span class="admin-icon">@await Html.PartialAsync("_IconPlan")</span>
                        <span class="admin-nav__text">Meu plano</span>
                    </a>

                    <a class="@Active("Organization")"
                       asp-controller="Organization"
                       asp-action="Index">
                        <span class="admin-icon">@await Html.PartialAsync("_IconOrganization")</span>
                        <span class="admin-nav__text">Organização</span>
                    </a>
                </div>
            }

            <div class="admin-nav__group">
                <span class="admin-nav__label">CONTA</span>

                <a class="@Active("Home")"
                   asp-controller="Home"
                   asp-action="Welcome"
                   title="Início">
                    <span class="admin-icon">@await Html.PartialAsync("_IconHome")</span>
                    <span class="admin-nav__text">Início</span>
                </a>

                <a class="@Active("MyAccount")"
                   asp-controller="MyAccount"
                   asp-action="Index"
                   title="Minha conta">
                    <span class="admin-icon">@await Html.PartialAsync("_IconUser")</span>
                    <span class="admin-nav__text">Minha conta</span>
                </a>
            </div>

        </nav>

        <div class="admin-sidebar__footer">

            <div class="admin-sidebar__profile">

                <span class="admin-sidebar__avatar">
                    @initial
                </span>

                <div class="admin-sidebar__profile-text">
                    <strong>@fullName</strong>
                    <small>
                        @(isPlatformAdmin ? "Administrador da plataforma" :
                          isTenantAdmin ? "Administrador" :
                          "Usuário")
                    </small>
                </div>

            </div>

        </div>

    </aside>

    <div class="admin-main">

        <header class="admin-topbar">

            <div class="admin-topbar__heading">
                <button type="button"
                        class="admin-mobile-toggle"
                        id="mobileNavToggle"
                        aria-controls="adminSidebar"
                        aria-expanded="false"
                        aria-label="Abrir menu">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </button>

                <div>
                    <p class="admin-breadcrumb">
                        Orizon / @currentSection
                    </p>

                    <h1>@title</h1>
                </div>
            </div>

            <div class="admin-operations" aria-label="Status e conta do usuário">

                <div class="admin-system-status" role="status" aria-label="Sistema operacional">
                    <span class="admin-system-status__dot" aria-hidden="true"></span>
                    <span>Sistema operacional</span>
                </div>

                <div class="admin-user">

                <span class="admin-avatar">
                    @initial
                </span>

                <span class="admin-user__name">@fullName</span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="admin-logout">
                        Sair
                    </button>

                </form>

                </div>

            </div>

        </header>

        <main class="admin-content">
            @RenderBody()
        </main>

    </div>

</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
(() => {
    const layout = document.getElementById("adminLayout");
    const sidebar = document.getElementById("adminSidebar");
    const desktopToggle = document.getElementById("sidebarToggle");
    const mobileToggle = document.getElementById("mobileNavToggle");
    const backdrop = document.getElementById("sidebarBackdrop");
    const navLinks = sidebar?.querySelectorAll("a") ?? [];
    const mobileQuery = window.matchMedia("(max-width: 900px)");

    if (!layout || !sidebar || !desktopToggle || !mobileToggle || !backdrop) {
        return;
    }

    const storageKey = "orizon-agents-sidebar-collapsed";
    const collapsed = localStorage.getItem(storageKey) === "true";

    if (collapsed) {
        layout.classList.add("admin-layout--collapsed");
        desktopToggle.textContent = "›";
        desktopToggle.setAttribute("aria-label", "Expandir menu");
        desktopToggle.setAttribute("title", "Expandir menu");
    }

    const setDrawer = (open, restoreFocus = false) => {
        const isOpen = mobileQuery.matches && open;

        layout.classList.toggle("admin-layout--drawer-open", isOpen);
        document.body.classList.toggle("admin-drawer-open", isOpen);
        mobileToggle.setAttribute("aria-expanded", isOpen.toString());
        mobileToggle.setAttribute("aria-label", isOpen ? "Fechar menu" : "Abrir menu");
        sidebar.inert = mobileQuery.matches && !isOpen;

        if (mobileQuery.matches) {
            sidebar.setAttribute("aria-hidden", (!isOpen).toString());
        } else {
            sidebar.removeAttribute("aria-hidden");
        }

        backdrop.setAttribute("aria-hidden", (!isOpen).toString());
        backdrop.tabIndex = isOpen ? 0 : -1;

        if (!isOpen && restoreFocus) {
            mobileToggle.focus();
        }
    };

    const syncViewport = () => setDrawer(false);

    desktopToggle.addEventListener("click", () => {
        if (mobileQuery.matches) {
            return;
        }

        const isCollapsed =
            layout.classList.toggle("admin-layout--collapsed");

        localStorage.setItem(storageKey, isCollapsed.toString());
        desktopToggle.textContent = isCollapsed ? "›" : "‹";
        desktopToggle.setAttribute("aria-label", isCollapsed ? "Expandir menu" : "Recolher menu");
        desktopToggle.setAttribute("title", isCollapsed ? "Expandir menu" : "Recolher menu");
    });

    mobileToggle.addEventListener("click", () => {
        setDrawer(!layout.classList.contains("admin-layout--drawer-open"));
    });

    backdrop.addEventListener("click", () => setDrawer(false, true));

    navLinks.forEach(link => {
        link.addEventListener("click", () => {
            if (mobileQuery.matches) {
                setDrawer(false);
            }
        });
    });

    document.addEventListener("keydown", event => {
        if (event.key === "Escape" && layout.classList.contains("admin-layout--drawer-open")) {
            setDrawer(false, true);
        }
    });

    if (typeof mobileQuery.addEventListener === "function") {
        mobileQuery.addEventListener("change", syncViewport);
    } else {
        mobileQuery.addListener(syncViewport);
    }

    syncViewport();
})();
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
