@using OrizonAgents.Application.Knowledge.Models
@model IReadOnlyList<KnowledgeBaseListItemDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Conhecimento";
    ViewData["Section"] = "Inteligência Artificial";
}

<section class="agents-page">
    <header class="agents-page__header">
        <div>
            <div class="agents-page__eyebrow">KNOWLEDGE</div>
            <h1>Bases de conhecimento</h1>
            <p>
                Organize documentos e informações que poderão ser utilizados
                pelos seus agentes.
            </p>
        </div>

        <a class="btn btn-primary agents-new-button"
           asp-action="Create">
            <span class="agents-new-button__icon">+</span>
            Nova base
        </a>
    </header>

    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-info">@message</div>
    }

    @if (Model.Count == 0)
    {
        <section class="agents-empty">
            <div class="agents-empty__visual">
                <span>◆</span>
            </div>

            <h2>Crie sua primeira base</h2>

            <p>
                Adicione documentos para construir o conhecimento
                especializado dos seus agentes.
            </p>

            <a class="btn btn-primary"
               asp-action="Create">
                + Criar base de conhecimento
            </a>
        </section>
    }
    else
    {
        <div class="agents-grid">
            @foreach (KnowledgeBaseListItemDto item in Model)
            {
                <article class="agent-product-card">
                    <div class="agent-product-card__top">
                        <div class="agent-product-card__avatar">
                            <span>◆</span>
                        </div>

                        <div class="agent-product-card__identity">
                            <div class="agent-product-card__title">
                                <h2>@item.Name</h2>

                                <span class="agent-status @(item.IsActive ? "agent-status--active" : "agent-status--inactive")">
                                    @(item.IsActive ? "Ativa" : "Inativa")
                                </span>
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "Base de conhecimento"
                                    : item.Description)
                            </p>
                        </div>
                    </div>

                    <div class="agent-product-card__meta">
                        <span>
                            <small>DOCUMENTOS</small>
                            <strong>@item.DocumentCount</strong>
                        </span>
                    </div>

                    <div class="agent-product-card__footer">
                        <a class="btn btn-primary"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Abrir base
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</section>
