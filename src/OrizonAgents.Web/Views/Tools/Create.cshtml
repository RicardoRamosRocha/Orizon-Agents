@model OrizonAgents.Web.Models.Tools.AgentToolFormViewModel

@{
    ViewData["Title"] = "Nova Tool";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-controller="Tools"
           asp-action="Index"
           class="text-decoration-none">
            ← Voltar para Tools
        </a>

        <div class="mt-3">
            <span class="text-uppercase small text-secondary fw-semibold">
                Nova capacidade
            </span>
            <h1 class="display-6 fw-bold mb-1">Criar Tool</h1>
            <p class="text-secondary mb-0">
                Configure uma API ou serviço que poderá ser utilizado pelos agentes.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Name"
                           class="form-label fw-semibold"></label>
                    <input asp-for="Name"
                           class="form-control form-control-lg"
                           placeholder="Ex.: consultar_disponibilidade" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description"
                           class="form-label fw-semibold"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Explique claramente quando o agente deve utilizar esta Tool."></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label asp-for="HttpMethod"
                               class="form-label fw-semibold"></label>

                        <select asp-for="HttpMethod"
                                class="form-select">
                            <option value="GET">GET</option>
                            <option value="POST">POST</option>
                            <option value="PUT">PUT</option>
                            <option value="PATCH">PATCH</option>
                            <option value="DELETE">DELETE</option>
                        </select>
                    </div>

                    <div class="col-md-9">
                        <label asp-for="Endpoint"
                               class="form-label fw-semibold"></label>
                        <input asp-for="Endpoint"
                               class="form-control"
                               placeholder="https://api.exemplo.com/recurso" />
                        <span asp-validation-for="Endpoint"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="InputSchema"
                           class="form-label fw-semibold"></label>

                    <textarea asp-for="InputSchema"
                              class="form-control font-monospace"
                              rows="8"
                              placeholder='{"type":"object","properties":{}}'></textarea>

                    <div class="form-text">
                        Opcional. Informe um JSON Schema para orientar a IA
                        sobre os parâmetros aceitos pela Tool.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit"
                            class="btn btn-primary px-4">
                        Criar Tool
                    </button>

                    <a asp-controller="Tools"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
