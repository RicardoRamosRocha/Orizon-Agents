@model IReadOnlyList<OrizonAgents.Application.Tools.Models.AgentToolBindingDto>

@{
    ViewData["Title"] = "Ferramentas do agente";
    Guid agentId = (Guid)ViewBag.AgentId;
    string agentName = (string)ViewBag.AgentName;
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-controller="Agents"
           asp-action="Index"
           class="text-decoration-none">
            ← Voltar para agentes
        </a>

        <div class="mt-3">
            <span class="text-uppercase small text-secondary fw-semibold">
                Capacidades do agente
            </span>

            <h1 class="display-6 fw-bold mb-1">
                Ferramentas
            </h1>

            <p class="text-secondary mb-0">
                Selecione quais Tools
                <strong>@agentName</strong>
                poderá utilizar durante suas execuções.
            </p>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-info">
            @statusMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center">
                <h2 class="h4 fw-bold">
                    Nenhuma Tool disponível
                </h2>

                <p class="text-secondary">
                    Cadastre uma Tool antes de adicionar
                    capacidades a este agente.
                </p>

                <a asp-controller="Tools"
                   asp-action="Create"
                   class="btn btn-primary">
                    Criar Tool
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var tool in Model)
            {
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                        <h2 class="h5 fw-bold mb-0">
                                            @tool.Name
                                        </h2>

                                        <span class="badge text-bg-dark">
                                            @tool.HttpMethod
                                        </span>

                                        @if (tool.IsBound)
                                        {
                                            <span class="badge text-bg-success">
                                                Vinculada
                                            </span>
                                        }
                                    </div>

                                    <p class="text-secondary mb-0">
                                        @tool.Description
                                    </p>
                                </div>
                            </div>

                            <div class="mt-4">
                                @if (!tool.IsActive)
                                {
                                    <button class="btn btn-outline-secondary"
                                            disabled>
                                        Tool desativada
                                    </button>
                                }
                                else
                                {
                                    <form asp-controller="Agents"
                                          asp-action="ChangeToolBinding"
                                          asp-route-id="@agentId"
                                          asp-route-toolId="@tool.ToolId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="bind"
                                               value="@(tool.IsBound ? "false" : "true")" />

                                        <button type="submit"
                                                class="btn @(tool.IsBound ? "btn-outline-danger" : "btn-primary")">
                                            @(tool.IsBound
                                                ? "Remover do agente"
                                                : "Adicionar ao agente")
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
