@using OrizonAgents.Application.Agents.Models
@model IReadOnlyList<AiAgentListItemDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Meus Agentes";
    ViewData["Section"] = "Inteligência Artificial";
}

<section class="agents-page">

    <header class="agents-page__header">
        <div>
            <div class="agents-page__eyebrow">
                WORKSPACE DE IA
            </div>

            <h1>Seus agentes</h1>

            <p>
                Crie assistentes inteligentes para trabalhar com você e sua equipe.
            </p>
        </div>

        <a class="btn btn-primary agents-new-button"
           asp-action="Create">
            <span class="agents-new-button__icon">+</span>
            Novo agente
        </a>
    </header>

    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-info">@message</div>
    }

    @if (Model.Count == 0)
    {
        <section class="agents-empty">
            <div class="agents-empty__visual">
                <span>✦</span>
            </div>

            <h2>Crie seu primeiro agente</h2>

            <p>
                Configure personalidade, instruções e modelo de IA.
                Seu novo assistente estará pronto para conversar em poucos passos.
            </p>

            <a class="btn btn-primary"
               asp-action="Create">
                + Criar meu primeiro agente
            </a>
        </section>
    }
    else
    {
        <div class="agents-grid">
            @foreach (AiAgentListItemDto agent in Model)
            {
                <article class="agent-product-card">

                    <div class="agent-product-card__top">

                        <div class="agent-product-card__avatar">
                            <span>✦</span>

                            @if (agent.IsActive)
                            {
                                <i class="agent-product-card__online"
                                   title="Agente ativo"></i>
                            }
                        </div>

                        <div class="agent-product-card__identity">
                            <div class="agent-product-card__title">
                                <h2>@agent.Name</h2>

                                @if (agent.IsActive)
                                {
                                    <span class="agent-status agent-status--active">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="agent-status agent-status--inactive">
                                        Inativo
                                    </span>
                                }
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(agent.Description)
                                    ? "Assistente de Inteligência Artificial"
                                    : agent.Description)
                            </p>
                        </div>

                    </div>

                    <div class="agent-product-card__meta">
                        <span>
                            <small>PROVEDOR</small>
                            <strong>@agent.Provider</strong>
                        </span>

                        <span>
                            <small>MODELO</small>
                            <strong>@agent.Model</strong>
                        </span>
                    </div>

                    <div class="agent-product-card__footer">

                        <a class="btn btn-primary agent-conversation-button"
                           asp-action="Test"
                           asp-route-id="@agent.Id">
                            <span>✦</span>
                            Conversar
                        </a>

                        <a class="btn btn-outline-secondary"
                           asp-action="Edit"
                           asp-route-id="@agent.Id">
                            Configurar
                        </a>

                        <a class="btn btn-outline-secondary"
                           asp-action="Tools"
                           asp-route-id="@agent.Id">
                            Ferramentas
                        </a>


                        <form method="post"
                              asp-action="ChangeStatus"
                              asp-route-id="@agent.Id">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="activate"
                                   value="@(!agent.IsActive ? "true" : "false")" />

                            @if (agent.IsActive)
                            {
                                <button type="submit"
                                        class="btn agent-status-button">
                                    Desativar
                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn agent-status-button">
                                    Ativar
                                </button>
                            }

                        </form>

                    </div>

                </article>
            }
        </div>
    }

</section>
