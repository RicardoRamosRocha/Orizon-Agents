@using OrizonAgents.Application.Agents.Models
@model IReadOnlyList<AiAgentListItemDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Meus Agentes";
    ViewData["Section"] = "Inteligência Artificial";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Meus Agentes</h1>
        <p class="text-muted mb-0">
            Crie, teste e gerencie seus assistentes de Inteligência Artificial.
        </p>
    </div>

    <a class="btn btn-primary" asp-action="Create">
        + Novo agente
    </a>
</div>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-info">@message</div>
}

@if (Model.Count == 0)
{
    <div class="border rounded bg-white p-5 text-center">
        <h2 class="h5 mb-2">Crie seu primeiro agente</h2>

        <p class="text-muted mb-4">
            Configure em poucos passos como seu assistente deve atender.
        </p>

        <a class="btn btn-primary" asp-action="Create">
            Criar agente
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (AiAgentListItemDto agent in Model)
        {
            <div class="col-12 col-xl-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h2 class="h5 mb-0">@agent.Name</h2>

                                    @if (agent.IsActive)
                                    {
                                        <span class="badge text-bg-success">
                                            Ativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inativo
                                        </span>
                                    }
                                </div>

                                <p class="text-muted mb-0">
                                    @(string.IsNullOrWhiteSpace(agent.Description)
                                        ? "Assistente de Inteligência Artificial"
                                        : agent.Description)
                                </p>
                            </div>
                        </div>

                        <div class="small text-muted mb-4">
                            @agent.Provider · @agent.Model
                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <a class="btn btn-primary"
                               asp-action="Edit"
                               asp-route-id="@agent.Id">
                                Editar
                            </a>

                            <a class="btn btn-outline-primary"
                               asp-action="Test"
                               asp-route-id="@agent.Id">
                                Testar agente
                            </a>

                            <form method="post"
                                  asp-action="ChangeStatus"
                                  asp-route-id="@agent.Id"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="activate"
                                       value="@(!agent.IsActive ? "true" : "false")" />

                                @if (agent.IsActive)
                                {
                                    <button type="submit"
                                            class="btn btn-outline-secondary">
                                        Desativar
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="btn btn-outline-success">
                                        Ativar
                                    </button>
                                }
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

