@model IReadOnlyList<OrizonAgents.Application.Knowledge.Models.AgentKnowledgeBindingDto>

@{
    ViewData["Title"] = "Conhecimento do agente";
    Guid agentId = (Guid)ViewBag.AgentId;
    string agentName = (string)ViewBag.AgentName;
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-controller="Agents"
           asp-action="Index"
           class="text-decoration-none">
            ← Voltar para agentes
        </a>

        <div class="mt-3">
            <span class="text-uppercase small text-secondary fw-semibold">
                Conhecimento do agente
            </span>

            <h1 class="display-6 fw-bold mb-1">
                Bases de conhecimento
            </h1>

            <p class="text-secondary mb-0">
                Selecione quais bases
                <strong>@agentName</strong>
                poderá consultar durante suas conversas.
            </p>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-info">
            @statusMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center">
                <h2 class="h4 fw-bold">
                    Nenhuma base disponível
                </h2>

                <p class="text-secondary">
                    Crie uma base e envie documentos antes
                    de adicionar conhecimento a este agente.
                </p>

                <a asp-controller="Knowledge"
                   asp-action="Create"
                   class="btn btn-primary">
                    Criar base de conhecimento
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var knowledgeBase in Model)
            {
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                <h2 class="h5 fw-bold mb-0">
                                    @knowledgeBase.KnowledgeBaseName
                                </h2>

                                @if (knowledgeBase.IsBound)
                                {
                                    <span class="badge text-bg-success">
                                        Vinculada
                                    </span>
                                }

                                @if (!knowledgeBase.IsActive)
                                {
                                    <span class="badge text-bg-secondary">
                                        Inativa
                                    </span>
                                }
                            </div>

                            <p class="text-secondary">
                                @(string.IsNullOrWhiteSpace(knowledgeBase.Description)
                                    ? "Base de conhecimento"
                                    : knowledgeBase.Description)
                            </p>

                            <div class="mb-4">
                                <span class="small text-secondary">
                                    Documentos:
                                    <strong>@knowledgeBase.DocumentCount</strong>
                                </span>
                            </div>

                            @if (!knowledgeBase.IsActive)
                            {
                                <button class="btn btn-outline-secondary"
                                        disabled>
                                    Base desativada
                                </button>
                            }
                            else
                            {
                                <form asp-controller="Agents"
                                      asp-action="ChangeKnowledgeBinding"
                                      asp-route-id="@agentId"
                                      asp-route-knowledgeBaseId="@knowledgeBase.KnowledgeBaseId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="bind"
                                           value="@(knowledgeBase.IsBound ? "false" : "true")" />

                                    <button type="submit"
                                            class="btn @(knowledgeBase.IsBound ? "btn-outline-danger" : "btn-primary")">
                                        @(knowledgeBase.IsBound
                                            ? "Remover do agente"
                                            : "Adicionar ao agente")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
