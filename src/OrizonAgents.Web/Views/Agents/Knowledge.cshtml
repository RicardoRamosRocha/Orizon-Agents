@model IReadOnlyList<OrizonAgents.Application.Knowledge.Models.AgentKnowledgeBindingDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Conhecimento do agente";
    ViewData["Section"] = "Agentes de IA";
    Guid agentId = (Guid)ViewBag.AgentId;
    string agentName = (string)ViewBag.AgentName;
}

<section class="cockpit-page">
    <header class="cockpit-page-header cockpit-page-header--form">
        <a asp-controller="Agents" asp-action="Index" class="cockpit-back-link">← Voltar para agentes</a>
        <p class="cockpit-eyebrow">Conhecimento do agente</p>
        <h1>Bases de conhecimento</h1>
        <p>Selecione quais bases <strong>@agentName</strong> poderá consultar nas conversas.</p>
    </header>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-info">@statusMessage</div>
    }

    @if (Model.Count == 0)
    {
        <section class="cockpit-empty-state">
            <h2>Nenhuma base disponível</h2>
            <p>Crie uma base e envie documentos antes de adicionar conhecimento ao agente.</p>
            <a asp-controller="Knowledge" asp-action="Create" class="btn btn-primary">Criar base</a>
        </section>
    }
    else
    {
        <div class="cockpit-bind-grid">
            @foreach (var knowledgeBase in Model)
            {
                <article class="cockpit-bind-card">
                    <div class="cockpit-bind-card__content">
                        <div class="cockpit-bind-card__title">
                            <h2>@knowledgeBase.KnowledgeBaseName</h2>
                            @if (knowledgeBase.IsBound)
                            {
                                <span class="cockpit-status cockpit-status--success">Vinculada</span>
                            }
                            @if (!knowledgeBase.IsActive)
                            {
                                <span class="cockpit-status cockpit-status--danger">Inativa</span>
                            }
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(knowledgeBase.Description)
                                ? "Base de conhecimento"
                                : knowledgeBase.Description)
                        </p>
                        <span class="cockpit-inline-metric">
                            <strong>@knowledgeBase.DocumentCount</strong>
                            documentos
                        </span>
                    </div>

                    <div class="cockpit-bind-card__action">
                        @if (!knowledgeBase.IsActive)
                        {
                            <button class="btn btn-outline-secondary" disabled>Base desativada</button>
                        }
                        else
                        {
                            <form asp-controller="Agents"
                                  asp-action="ChangeKnowledgeBinding"
                                  asp-route-id="@agentId"
                                  asp-route-knowledgeBaseId="@knowledgeBase.KnowledgeBaseId"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bind" value="@(knowledgeBase.IsBound ? "false" : "true")" />
                                <button type="submit"
                                        class="btn @(knowledgeBase.IsBound ? "btn-outline-danger" : "btn-primary")">
                                    @(knowledgeBase.IsBound ? "Remover do agente" : "Adicionar ao agente")
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
