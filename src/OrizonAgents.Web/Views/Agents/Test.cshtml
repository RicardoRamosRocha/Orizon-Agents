@model OrizonAgents.Web.Models.Agents.AiAgentTestViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Testar Agente";
    ViewData["Section"] = "Inteligência Artificial";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none small">
        ← Meus Agentes
    </a>

    <div class="d-flex align-items-center gap-2 mt-3">
        <h1 class="h3 mb-0">@Model.AgentName</h1>
        <span class="badge text-bg-success">Em teste</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.AgentDescription))
    {
        <p class="text-muted mt-1 mb-0">
            @Model.AgentDescription
        </p>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="row g-0">

        <aside class="col-lg-3 border-end bg-light">
            <div class="p-3 p-lg-4">

                <a asp-action="Test"
                   asp-route-id="@Model.AgentId"
                   class="btn btn-primary w-100 mb-4">
                    + Nova conversa
                </a>

                <div class="small text-uppercase fw-semibold text-muted mb-2">
                    Conversas anteriores
                </div>

                @if (Model.Conversations.Count == 0)
                {
                    <div class="small text-muted py-3">
                        Nenhuma conversa salva ainda.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var conversation in Model.Conversations)
                        {
                            bool isActive =
                                Model.ConversationId == conversation.Id;

                            <a asp-action="Test"
                               asp-route-id="@Model.AgentId"
                               asp-route-conversationId="@conversation.Id"
                               class="text-decoration-none rounded-3 p-3 @(isActive ? "bg-white border shadow-sm" : "text-dark")">

                                <div class="fw-semibold text-truncate">
                                    @conversation.Title
                                </div>

                                <div class="small text-muted mt-1">
                                    @{
                                        DateTime activityDate =
                                            conversation.UpdatedAtUtc
                                            ?? conversation.CreatedAtUtc;
                                    }

                                    @activityDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </a>
                        }
                    </div>
                }

            </div>
        </aside>

        <section class="col-lg-9">
            <div class="d-flex flex-column" style="min-height: 620px;">

                <div class="border-bottom px-4 py-3">
                    <div class="fw-semibold">
                        @if (Model.ConversationId.HasValue)
                        {
                            <span>Conversa com @Model.AgentName</span>
                        }
                        else
                        {
                            <span>Nova conversa</span>
                        }
                    </div>

                    <div class="small text-muted">
                        O agente mantém o contexto desta conversa.
                    </div>
                </div>

                <div class="flex-grow-1 p-4"
                     style="min-height: 390px; max-height: 520px; overflow-y: auto;">

                    @if (Model.Messages.Count == 0)
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 text-center">
                            <div class="text-muted py-5">
                                <div class="fw-semibold mb-2">
                                    Converse com @Model.AgentName
                                </div>

                                <div class="small">
                                    Envie uma mensagem para iniciar uma nova conversa.
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var message in Model.Messages)
                        {
                            if (message.Role == "user")
                            {
                                <div class="d-flex justify-content-end mb-3">
                                    <div class="bg-primary text-white rounded-3 px-3 py-2"
                                         style="max-width: 75%;">
                                        <div class="small opacity-75 mb-1">
                                            Você
                                        </div>

                                        <div style="white-space: pre-wrap;">@message.Content</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-start mb-3">
                                    <div class="bg-light border rounded-3 px-3 py-2"
                                         style="max-width: 75%;">
                                        <div class="small text-muted mb-1">
                                            @Model.AgentName
                                        </div>

                                        <div style="white-space: pre-wrap;">@message.Content</div>
                                    </div>
                                </div>
                            }
                        }
                    }

                </div>

                <div class="border-top p-3 p-lg-4">
                    <form method="post">
                        <input type="hidden" asp-for="AgentId" />
                        <input type="hidden" asp-for="ConversationId" />

                        <div class="input-group">
                            <textarea asp-for="Message"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Digite sua mensagem..."></textarea>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Enviar
                            </button>
                        </div>

                        <span asp-validation-for="Message"
                              class="text-danger small"></span>
                    </form>
                </div>

            </div>
        </section>

    </div>
</div>

<div class="text-muted small mt-3">
    As conversas são salvas para manter o contexto durante os testes.
</div>
