@model OrizonAgents.Web.Models.Agents.AiAgentTestViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Conversar";
    ViewData["Section"] = "Inteligência Artificial";
}

<section class="ai-chat-page">

    <header class="ai-chat-page__header">
        <div>
            <a asp-action="Index" class="ai-chat-back">
                ← Meus Agentes
            </a>

            <div class="ai-chat-agent">
                <div class="ai-chat-agent__avatar">
                    <span>✦</span>
                    <i></i>
                </div>

                <div>
                    <div class="ai-chat-agent__title">
                        <h1>@Model.AgentName</h1>
                        <span>Ativo</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.AgentDescription))
                    {
                        <p>@Model.AgentDescription</p>
                    }
                    else
                    {
                        <p>Assistente de Inteligência Artificial</p>
                    }
                </div>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <div class="ai-chat-workspace">

        <aside class="ai-chat-history">

            <div class="ai-chat-history__header">
                <div>
                    <span class="ai-chat-history__eyebrow">CONVERSAS</span>
                    <h2>Histórico</h2>
                </div>

                <a asp-action="Test"
                   asp-route-id="@Model.AgentId"
                   class="ai-chat-new"
                   title="Nova conversa">
                    +
                </a>
            </div>

            @if (Model.Conversations.Count == 0)
            {
                <div class="ai-chat-history__empty">
                    <div>✦</div>
                    <p>Nenhuma conversa salva ainda.</p>
                </div>
            }
            else
            {
                <div class="ai-chat-history__list">

                    @foreach (var conversation in Model.Conversations)
                    {
                        bool isActive =
                            Model.ConversationId == conversation.Id;

                        DateTime activityDate =
                            conversation.UpdatedAtUtc
                            ?? conversation.CreatedAtUtc;

                        <a asp-action="Test"
                           asp-route-id="@Model.AgentId"
                           asp-route-conversationId="@conversation.Id"
                           class="ai-chat-history__item @(isActive ? "is-active" : "")">

                            <span class="ai-chat-history__icon">✦</span>

                            <span class="ai-chat-history__content">
                                <strong>@conversation.Title</strong>

                                <small>
                                    @activityDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </span>

                        </a>
                    }

                </div>
            }

            <div class="ai-chat-history__footer">
                <span class="ai-chat-context-dot"></span>
                Memória de contexto ativa
            </div>

        </aside>

        <section class="ai-chat-conversation">

            <header class="ai-chat-conversation__header">
                <div>
                    @if (Model.ConversationId.HasValue)
                    {
                        <h2>Conversa com @Model.AgentName</h2>
                    }
                    else
                    {
                        <h2>Nova conversa</h2>
                    }

                    <p>O agente mantém o contexto durante esta conversa.</p>
                </div>

                <div class="ai-chat-live">
                    <span></span>
                    IA disponível
                </div>
            </header>

            <div class="ai-chat-messages">

                @if (Model.Messages.Count == 0)
                {
                    <div class="ai-chat-welcome">

                        <div class="ai-chat-welcome__mark">
                            ✦
                        </div>

                        <h2>Como posso ajudar?</h2>

                        <p>
                            Converse com @Model.AgentName.
                            O contexto será mantido enquanto vocês trabalham juntos.
                        </p>

                        <div class="ai-chat-suggestions">
                            <button type="button"
                                    data-chat-suggestion="Olá! Como você pode me ajudar?">
                                Conhecer o agente
                            </button>

                            <button type="button"
                                    data-chat-suggestion="Quais tarefas você consegue realizar?">
                                Ver capacidades
                            </button>
                        </div>

                    </div>
                }
                else
                {
                    @foreach (var message in Model.Messages)
                    {
                        if (message.Role == "user")
                        {
                            <div class="ai-message ai-message--user">

                                <div class="ai-message__bubble">
                                    <div class="ai-message__label">
                                        Você
                                    </div>

                                    <div class="ai-message__content">
                                        @message.Content
                                    </div>
                                </div>

                                <div class="ai-message__avatar ai-message__avatar--user">
                                    EU
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="ai-message ai-message--agent">

                                <div class="ai-message__avatar">
                                    ✦
                                </div>

                                <div class="ai-message__body">
                                    <div class="ai-message__label">
                                        @Model.AgentName
                                    </div>

                                    <div class="ai-message__content">
                                        @message.Content
                                    </div>
                                </div>

                            </div>
                        }
                    }
                }

            </div>

            <div class="ai-chat-thinking" id="aiChatThinking" hidden>
    <div class="ai-message__avatar">✦</div>

    <div class="ai-chat-thinking__body">
        <span>@Model.AgentName está pensando</span>

        <div class="ai-chat-thinking__dots">
            <i></i>
            <i></i>
            <i></i>
        </div>
    </div>
</div>

<footer class="ai-chat-composer">

                <form method="post" class="ai-chat-composer__form" id="aiChatForm">

                    <input type="hidden" asp-for="AgentId" />
                    <input type="hidden" asp-for="ConversationId" />

                    <div class="ai-chat-composer__box">

                        <textarea asp-for="Message"
                                  rows="2"
                                  placeholder="Converse com @Model.AgentName..."
                                  id="aiChatMessage"></textarea>

                        <button type="submit"
                                class="ai-chat-send"
                                title="Enviar mensagem">
                            <span>Enviar</span>
                            <strong>↑</strong>
                        </button>

                    </div>

                    <div class="ai-chat-composer__meta">
                        <span asp-validation-for="Message"
                              class="text-danger"></span>

                        <small>
                            Enter para nova linha · suas conversas ficam salvas
                        </small>
                    </div>

                </form>

            </footer>

        </section>

    </div>

</section>

@section Scripts {
    <script>
        document.querySelectorAll("[data-chat-suggestion]")
            .forEach(function (button) {
                button.addEventListener("click", function () {
                    const input = document.getElementById("aiChatMessage");

                    if (!input) {
                        return;
                    }

                    input.value = button.dataset.chatSuggestion || "";
                    input.focus();
                });
            });

        const form = document.getElementById("aiChatForm");
const thinking = document.getElementById("aiChatThinking");
const sendButton = form?.querySelector(".ai-chat-send");

if (form) {
    form.addEventListener("submit", function () {
        if (thinking) {
            thinking.hidden = false;
        }

        if (sendButton) {
            sendButton.disabled = true;
        }

        window.setTimeout(function () {
            thinking?.scrollIntoView({
                behavior: "smooth",
                block: "end"
            });
        }, 50);
    });
}

const messages = document.querySelector(".ai-chat-messages");

        if (messages) {
            messages.scrollTop = messages.scrollHeight;
        }
    </script>
}

