@model OrizonAgents.Web.Models.Agents.AiAgentFormViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Agente";
    ViewData["Section"] = "Inteligência Artificial";
}

<div class="cockpit-page-header cockpit-page-header--form">
    <a asp-action="Index" class="cockpit-back-link">← Voltar para agentes</a>
    <p class="cockpit-eyebrow">Agentes</p>
    <div class="cockpit-form-title-row">
        <h1>Editar agente</h1>
        <span class="cockpit-status cockpit-status--@(Model.IsActive ? "success" : "danger")">
            @(Model.IsActive ? "Ativo" : "Inativo")
        </span>
    </div>
    <p>
        Ajuste o comportamento e as configurações do agente.
    </p>
</div>

<div class="border rounded bg-white p-4 col-xl-8 cockpit-form-panel cockpit-form-panel--narrow">
    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SystemPrompt" class="form-label"></label>

            <textarea asp-for="SystemPrompt"
                      class="form-control"
                      rows="8"></textarea>

            <div class="form-text">
                Explique como o agente deve atender e quais regras deve seguir.
            </div>

            <span asp-validation-for="SystemPrompt"
                  class="text-danger"></span>
        </div>

        <details class="mb-4 cockpit-details">
            <summary class="fw-semibold">
                Configurações avançadas
            </summary>

            <div class="row mt-3">
                <div class="col-md-6 mb-3">
                    <label asp-for="Provider" class="form-label"></label>

                    <select asp-for="Provider" class="form-select">
                        <option value="Groq">Groq (gratuito)</option>
                        <option value="OpenAI">OpenAI</option>
                        <option value="GoogleGemini">Google Gemini</option>
                        <option value="AnthropicClaude">Anthropic Claude</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Model" class="form-label"></label>

                    <select asp-for="Model"
                            class="form-select"
                            data-current-model="@Model.Model">
                        <option value="@Model.Model">@Model.Model</option>
                    </select>

                    <div id="modelHelp"
                         class="form-text">
                        Os modelos disponíveis dependem do provedor selecionado.
                    </div>

                    <span asp-validation-for="Model"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Temperature" class="form-label"></label>

                    <input asp-for="Temperature"
                           class="form-control"
                           type="number"
                           min="0"
                           max="2"
                           step="0.1" />
                </div>
            </div>
        </details>

        <div class="cockpit-form-actions">
            <button type="submit" class="btn btn-primary">
                Salvar alterações
            </button>

            <a class="btn btn-outline-secondary" asp-action="Index">
                Cancelar
            </a>
        </div>

    </form>
</div>


@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const providerSelect = document.getElementById("Provider");
    const modelSelect = document.getElementById("Model");
    const modelHelp = document.getElementById("modelHelp");

    if (!providerSelect || !modelSelect) {
        return;
    }

    const initialModel = modelSelect.dataset.currentModel || "";

    async function loadModels(preserveCurrent) {
        const provider = providerSelect.value;

        modelSelect.disabled = true;
        modelHelp.textContent = "Carregando modelos disponíveis...";

        try {
            const response = await fetch(
                `/agentes/modelos?provider=${encodeURIComponent(provider)}`,
                {
                    headers: {
                        "Accept": "application/json"
                    }
                });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || "Não foi possível carregar os modelos.");
            }

            modelSelect.innerHTML = "";

            if (!Array.isArray(data) || data.length === 0) {
                const option = document.createElement("option");
                option.value = "";
                option.textContent = "Nenhum modelo disponível";
                modelSelect.appendChild(option);

                modelHelp.textContent =
                    "Não há modelos disponíveis para este provedor.";
                return;
            }

            for (const item of data) {
                const option = document.createElement("option");
                option.value = item.id;
                option.textContent = item.displayName || item.id;
                modelSelect.appendChild(option);
            }

            if (preserveCurrent &&
                initialModel &&
                data.some(item => item.id === initialModel)) {
                modelSelect.value = initialModel;
            }

            modelHelp.textContent =
                `${data.length} modelo(s) disponível(is) para este provedor.`;
        }
        catch (error) {
            modelSelect.innerHTML = "";

            const option = document.createElement("option");
            option.value = "";
            option.textContent = "Modelos indisponíveis";
            modelSelect.appendChild(option);

            modelHelp.textContent = error.message;
        }
        finally {
            modelSelect.disabled = false;
        }
    }

    providerSelect.addEventListener("change", function () {
        loadModels(false);
    });

    loadModels(true);
});
</script>
}
