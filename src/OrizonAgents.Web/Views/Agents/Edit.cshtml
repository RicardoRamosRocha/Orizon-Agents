@model OrizonAgents.Web.Models.Agents.AiAgentFormViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Agente";
    ViewData["Section"] = "Inteligência Artificial";
}

<div class="mb-4">
    <h1 class="h4 mb-1">Editar Agente</h1>
    <p class="text-muted mb-0">
        Ajuste o comportamento e as configurações do agente.
    </p>
</div>

<div class="border rounded bg-white p-4 col-xl-8">
    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SystemPrompt" class="form-label"></label>

            <textarea asp-for="SystemPrompt"
                      class="form-control"
                      rows="8"></textarea>

            <div class="form-text">
                Explique como o agente deve atender e quais regras deve seguir.
            </div>

            <span asp-validation-for="SystemPrompt"
                  class="text-danger"></span>
        </div>

        <details class="mb-4">
            <summary class="fw-semibold">
                Configurações avançadas
            </summary>

            <div class="row mt-3">
                <div class="col-md-6 mb-3">
                    <label asp-for="Provider" class="form-label"></label>

                    <select asp-for="Provider" class="form-select">
                        <option value="Groq">Groq (gratuito)</option>
                        <option value="OpenAI">OpenAI</option>
                        <option value="GoogleGemini">Google Gemini</option>
                        <option value="AnthropicClaude">Anthropic Claude</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Temperature" class="form-label"></label>

                    <input asp-for="Temperature"
                           class="form-control"
                           type="number"
                           min="0"
                           max="2"
                           step="0.1" />
                </div>
            </div>
        </details>

        <button type="submit" class="btn btn-primary">
            Salvar alterações
        </button>

        <a class="btn btn-link" asp-action="Index">
            Voltar
        </a>

    </form>
</div>

