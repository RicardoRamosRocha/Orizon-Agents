@model WhatsAppMessagesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mensagens WhatsApp";
    ViewData["Section"] = "WhatsApp";
}

<section class="cockpit-page whatsapp-page">
    <header class="cockpit-page-header">
        <div>
            <p class="cockpit-eyebrow">WhatsApp</p>
            <h1>Mensagens técnicas</h1>
            <p>Acompanhe eventos e envios operacionais sem expor conversas completas.</p>
        </div>
    </header>
    <nav class="whatsapp-tabs" aria-label="Navegação do WhatsApp">
        <a asp-action="Index">Conexões</a>
        <a asp-action="Templates">Templates</a>
        <a asp-action="Messages" class="is-active" aria-current="page">Mensagens técnicas</a>
    </nav>
    <section class="cockpit-metrics whatsapp-metrics whatsapp-metrics--single" aria-label="Uso mensal do WhatsApp">
        <article class="cockpit-metric cockpit-metric--success">
            <div class="cockpit-metric__top">
                <span class="cockpit-metric__label">Uso mensal</span>
                <span class="cockpit-metric__icon" aria-hidden="true">↗</span>
            </div>
            <strong>@(Model.Usage?.MonthlyMessagesUsed ?? 0)</strong>
            <div class="cockpit-metric__meta">
                <span class="cockpit-signal" aria-hidden="true"></span>
                <small>Limite: @(Model.Usage?.MonthlyMessageLimit?.ToString() ?? "Ilimitado")</small>
            </div>
        </article>
    </section>
    <article class="cockpit-panel whatsapp-panel">
        <header class="cockpit-panel__header">
            <div>
                <p class="cockpit-eyebrow">Operação</p>
                <h3>Eventos e envios</h3>
                <p class="whatsapp-panel__description">Registros técnicos retornados pela operação do canal.</p>
            </div>
        </header>
        @if (Model.Result?.Items.Count > 0)
        {
            <div class="table-wrap whatsapp-table-wrap">
                <table class="whatsapp-table">
                    <thead><tr><th>Data</th><th>Direção</th><th>Tipo</th><th>Status</th><th>De</th><th>Para</th><th>Erro</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Result.Items)
                    {
                        <tr>
                            <td>@item.CreatedAtUtc.ToString("g")</td><td>@item.Direction</td><td>@item.Type</td>
                            <td><span class="cockpit-status cockpit-status--neutral">@item.Status</span></td>
                            <td>@item.Sender</td><td>@item.Recipient</td><td class="whatsapp-error">@item.ErrorMessage</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="cockpit-empty-state cockpit-empty-state--compact">
                <h2>Nenhuma mensagem técnica registrada.</h2>
                <p>Os eventos do canal aparecerão aqui quando forem processados.</p>
            </div>
        }
    </article>
</section>
