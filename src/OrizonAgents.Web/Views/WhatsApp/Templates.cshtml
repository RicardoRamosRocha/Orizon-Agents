@model WhatsAppTemplatesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Templates WhatsApp";
    ViewData["Section"] = "WhatsApp";
}

<section class="cockpit-page whatsapp-page">
    <header class="cockpit-page-header">
        <div>
            <p class="cockpit-eyebrow">WhatsApp</p>
            <h1>Templates</h1>
            <p>Consulte e sincronize os modelos disponíveis nas conexões do canal.</p>
        </div>
    </header>
    <nav class="whatsapp-tabs" aria-label="Navegação do WhatsApp">
        <a asp-action="Index">Conexões</a>
        <a asp-action="Templates" class="is-active" aria-current="page">Templates</a>
        <a asp-action="Messages">Mensagens técnicas</a>
    </nav>
    <article class="cockpit-panel whatsapp-panel">
        <header class="cockpit-panel__header whatsapp-panel__header">
            <div>
                <p class="cockpit-eyebrow">Meta</p>
                <h3>Modelos sincronizados</h3>
                <p class="whatsapp-panel__description">Somente metadados retornados pelas conexões configuradas.</p>
            </div>
            @if (Model.Connections.Count > 0)
            {
                <form asp-action="SyncTemplates" method="post" class="whatsapp-sync-form">
                    @Html.AntiForgeryToken()
                    <label class="visually-hidden" for="templateConnection">Conexão</label>
                    <select id="templateConnection" name="connectionId" class="form-select">
                        @foreach (var connection in Model.Connections)
                        {
                            <option value="@connection.Id">@connection.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Sincronizar</button>
                </form>
            }
        </header>
        @if (Model.Result?.Items.Count > 0)
        {
            <div class="table-wrap whatsapp-table-wrap">
                <table class="whatsapp-table">
                    <thead><tr><th>Nome</th><th>Idioma</th><th>Categoria</th><th>Status</th><th>Conexão</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Result.Items)
                    {
                        <tr>
                            <td><strong>@item.Name</strong></td><td>@item.Language</td><td>@item.Category</td>
                            <td><span class="cockpit-status cockpit-status--neutral">@item.Status</span></td>
                            <td>@item.ConnectionName</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="cockpit-empty-state cockpit-empty-state--compact">
                <h2>Nenhum template sincronizado.</h2>
                <p>Sincronize uma conexão para carregar os metadados disponíveis.</p>
            </div>
        }
    </article>
</section>
