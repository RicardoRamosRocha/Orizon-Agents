@model WhatsAppIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "WhatsApp Cloud API";
    ViewData["Section"] = "WhatsApp";
    var summary = Model.Summary!;
}

<section class="cockpit-page whatsapp-page">
    <header class="cockpit-page-header">
        <div>
            <p class="cockpit-eyebrow">WhatsApp</p>
            <h1>WhatsApp Cloud API</h1>
            <p>Gerencie conexões, templates e operação do canal.</p>
        </div>
    </header>

    <nav class="whatsapp-tabs" aria-label="Navegação do WhatsApp">
        <a asp-action="Index" class="is-active" aria-current="page">Conexões</a>
        <a asp-action="Templates">Templates</a>
        <a asp-action="Messages">Mensagens técnicas</a>
    </nav>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    <section class="cockpit-metrics whatsapp-metrics" aria-label="Uso do WhatsApp">
        <article class="cockpit-metric cockpit-metric--success">
            <div class="cockpit-metric__top">
                <span class="cockpit-metric__label">Números</span>
                <span class="cockpit-metric__icon" aria-hidden="true">#</span>
            </div>
            <strong>@summary.Usage.ActiveNumbers</strong>
            <div class="cockpit-metric__meta">
                <span class="cockpit-signal" aria-hidden="true"></span>
                <small>Limite: @(summary.Usage.NumberLimit?.ToString() ?? "Ilimitado")</small>
            </div>
        </article>
        <article class="cockpit-metric">
            <div class="cockpit-metric__top">
                <span class="cockpit-metric__label">Mensagens no mês</span>
                <span class="cockpit-metric__icon" aria-hidden="true">↗</span>
            </div>
            <strong>@summary.Usage.MonthlyMessagesUsed</strong>
            <div class="cockpit-metric__meta">
                <span class="cockpit-signal" aria-hidden="true"></span>
                <small>Saldo: @(summary.Usage.MonthlyMessageLimit.HasValue ? summary.Usage.RemainingMonthlyMessages : "Ilimitado")</small>
            </div>
        </article>
    </section>

    <article class="cockpit-panel whatsapp-panel">
        <header class="cockpit-panel__header">
            <div>
                <p class="cockpit-eyebrow">Canal</p>
                <h3>Conexões</h3>
                <p class="whatsapp-panel__description">Números configurados no workspace.</p>
            </div>
            <span class="cockpit-status cockpit-status--neutral">
                @summary.Connections.Count @(summary.Connections.Count == 1 ? "conexão" : "conexões")
            </span>
        </header>

        @if (summary.Connections.Count == 0)
        {
            <div class="cockpit-empty-state cockpit-empty-state--compact">
                <h2>Nenhuma conexão WhatsApp configurada.</h2>
                <p>Adicione uma conexão para iniciar a operação do canal.</p>
            </div>
        }
        else
        {
            <div class="whatsapp-connection-list">
                @foreach (var connection in summary.Connections)
                {
                    <section class="whatsapp-connection-card">
                        <header class="whatsapp-connection-card__header">
                            <span class="whatsapp-connection-card__mark" aria-hidden="true">W</span>
                            <div>
                                <div class="whatsapp-connection-card__title">
                                    <h4>@connection.Name</h4>
                                    <span class="cockpit-status cockpit-status--neutral">@connection.Status</span>
                                    @if (connection.IsDefault)
                                    {
                                        <span class="cockpit-status cockpit-status--success">Padrão</span>
                                    }
                                </div>
                                <p>@connection.DisplayPhoneNumber</p>
                            </div>
                        </header>
                        <dl class="whatsapp-connection-card__meta">
                            <div><dt>Qualidade</dt><dd>@connection.QualityRating</dd></div>
                            <div><dt>Token</dt><dd>@connection.MaskedToken</dd></div>
                        </dl>
                        <div class="whatsapp-connection-actions">
                            <form asp-action="Validate" asp-route-id="@connection.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary">Validar</button>
                            </form>
                            <form asp-action="SetDefault" asp-route-id="@connection.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="concurrencyStamp" value="@connection.ConcurrencyStamp" />
                                <button type="submit" class="btn btn-outline-secondary">Definir padrão</button>
                            </form>
                            <form asp-action="Disconnect" asp-route-id="@connection.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="concurrencyStamp" value="@connection.ConcurrencyStamp" />
                                <button type="submit" class="btn btn-outline-danger">Desconectar</button>
                            </form>
                            <form asp-action="ReplaceToken" asp-route-id="@connection.Id" method="post" class="whatsapp-token-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="concurrencyStamp" value="@connection.ConcurrencyStamp" />
                                <label class="visually-hidden" for="token-@connection.Id">Novo token para @connection.Name</label>
                                <input id="token-@connection.Id" name="accessToken" type="password" class="form-control"
                                       autocomplete="new-password" placeholder="Novo token" />
                                <button type="submit" class="btn btn-outline-secondary">Trocar token</button>
                            </form>
                        </div>
                    </section>
                }
            </div>
        }
    </article>

    <article class="cockpit-panel whatsapp-panel whatsapp-form-panel">
        <header class="cockpit-panel__header">
            <div>
                <p class="cockpit-eyebrow">Configuração</p>
                <h3>Adicionar conexão</h3>
                <p class="whatsapp-panel__description">O token será criptografado e nunca exibido.</p>
            </div>
        </header>
        <form asp-action="Create" method="post" class="cockpit-form whatsapp-connection-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="whatsapp-form-grid">
                <div class="whatsapp-field">
                    <label asp-for="Form.Name" class="form-label"></label>
                    <input asp-for="Form.Name" name="Name" class="form-control" />
                    <span asp-validation-for="Form.Name" class="text-danger"></span>
                </div>
                <div class="whatsapp-field">
                    <label asp-for="Form.WhatsAppBusinessAccountId" class="form-label"></label>
                    <input asp-for="Form.WhatsAppBusinessAccountId" name="WhatsAppBusinessAccountId" class="form-control" />
                    <span asp-validation-for="Form.WhatsAppBusinessAccountId" class="text-danger"></span>
                </div>
                <div class="whatsapp-field">
                    <label asp-for="Form.PhoneNumberId" class="form-label"></label>
                    <input asp-for="Form.PhoneNumberId" name="PhoneNumberId" class="form-control" />
                    <span asp-validation-for="Form.PhoneNumberId" class="text-danger"></span>
                </div>
                <div class="whatsapp-field">
                    <label asp-for="Form.DisplayPhoneNumber" class="form-label"></label>
                    <input asp-for="Form.DisplayPhoneNumber" name="DisplayPhoneNumber" class="form-control" />
                    <span asp-validation-for="Form.DisplayPhoneNumber" class="text-danger"></span>
                </div>
                <div class="whatsapp-field whatsapp-field--wide">
                    <label asp-for="Form.VerifiedName" class="form-label"></label>
                    <input asp-for="Form.VerifiedName" name="VerifiedName" class="form-control" />
                    <span asp-validation-for="Form.VerifiedName" class="text-danger"></span>
                </div>
                <div class="whatsapp-field whatsapp-field--wide">
                    <label asp-for="Form.AccessToken" class="form-label"></label>
                    <input asp-for="Form.AccessToken" name="AccessToken" type="password" class="form-control"
                           autocomplete="new-password" />
                    <span asp-validation-for="Form.AccessToken" class="text-danger"></span>
                </div>
            </div>
            <div class="whatsapp-form-footer">
                <label class="whatsapp-checkbox">
                    <input asp-for="Form.IsDefault" name="IsDefault" />
                    <span>Definir como padrão</span>
                </label>
                <button type="submit" class="btn btn-primary">Salvar conexão</button>
            </div>
        </form>
    </article>
</section>
